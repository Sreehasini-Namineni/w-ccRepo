# Copy to server/.env and fill in. server/.env is git-ignored.

# --- Claude (signal extraction) ---
# Leave unset if you've run `ant auth login`; the SDK finds that profile on its own.
ANTHROPIC_API_KEY=

# --- Gmail (Google) ---
# Google Cloud console: enable the Gmail API, then create an OAuth client of type
# "Desktop app" and paste its ID and secret here. See server/README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack ---
# Your Slack app's *User OAuth Token* (starts with xoxp-). You can also paste it on the Sources page.
# Add these under "User Token Scopes": channels:read channels:history groups:read groups:history
# im:read im:history mpim:read mpim:history users:read users:read.email team:read
SLACK_TOKEN=

# --- Test clients (optional) ---
# Addresses that count as client contacts even on public domains like @gmail.com.
# Format: Client Name: email, email; Other Client: email
SKYLINE_TEST_CLIENTS=

# --- Sync ---
PORT=8787
# How far back the first sync reads
SKYLINE_LOOKBACK_DAYS=21
# Minutes between automatic syncs (0 turns auto-sync off)
SKYLINE_SYNC_MINUTES=5
