# Copy to server/.env and fill in. server/.env is git-ignored.

# --- Claude (signal extraction) ---
# Leave unset if you've run `ant auth login`; the SDK finds that profile on its own.
ANTHROPIC_API_KEY=

# --- Outlook (Microsoft Graph) ---
# App registration in Microsoft Entra: platform "Mobile and desktop applications",
# redirect URI http://localhost:8787/auth/outlook/callback,
# delegated permissions User.Read and Mail.Read. See server/README.md.
MS_CLIENT_ID=
# "common" works for work, school and personal accounts. Use your tenant ID to lock it down.
MS_TENANT=common
# Only needed if you registered the app as a "Web" platform instead.
MS_CLIENT_SECRET=
# Where "Open in Outlook" drafts go: https://outlook.office.com (work) or https://outlook.live.com (personal)
OUTLOOK_WEB=https://outlook.office.com

# --- Slack ---
# A user token (xoxp-...) or bot token (xoxb-...) from your Slack app. You can also paste it
# on the Sources page instead. Scopes: channels:read channels:history groups:read groups:history
# im:read im:history mpim:read mpim:history users:read users:read.email team:read
SLACK_TOKEN=

# --- Sync ---
PORT=8787
# How far back the first sync reads
SKYLINE_LOOKBACK_DAYS=21
# Minutes between automatic syncs (0 turns auto-sync off)
SKYLINE_SYNC_MINUTES=5
